# Production AdMob IDs for RELEASE builds.
# Copy this file to `admob.properties` (same folder) and replace every value with your own IDs.
# Debug builds always use Google's test IDs. Any key missing here makes the release build
# fall back to the test ID for that key and print a Gradle warning.

admob_app_id=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

admob_app_open_splash_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_app_open_resume_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

admob_inter_splash_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_inter_main_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_inter_on_boarding_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

admob_rewarded_ai_feature_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_rewarded_inter_ai_feature_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Ad slots: a native and a banner unit each; the ads control decides which one is shown.
admob_native_splash_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_splash_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_language_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_language_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Onboarding, one shared ad for all pages (shared mode)
admob_native_on_boarding_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_on_boarding_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Onboarding pages 1-4 (per_page mode), each its own native + banner unit
admob_native_ob1_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_ob1_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_ob2_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_ob2_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_ob3_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_ob3_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_ob4_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_ob4_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_main_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_main_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Main screen tabs, each its own native + banner unit
admob_native_home_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_home_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_explore_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_explore_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_history_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_history_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_settings_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_settings_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

admob_native_feature_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Activities ads test screens (sample of an Activity-based app)
admob_native_activity_one_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_activity_one_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_inter_activity_one_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_native_activity_two_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_banner_activity_two_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admob_rewarded_activity_two_id=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
