<?xml version="1.0" encoding="utf-8"?>
<!-- Shown for a moment before a full-screen ad, so the ad doesn't appear out of nowhere. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/nextgen_dialog_background"
    android:gravity="center"
    android:minWidth="200dp"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="24dp">

    <ProgressBar
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminate="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/nextgen_ad_loading"
        android:textColor="@color/nextgen_dialog_text"
        android:textSize="16sp" />
</LinearLayout>
