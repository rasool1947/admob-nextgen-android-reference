<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the app for a moment before the App Open ad shown on returning to the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nextgen_dialog_background"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/nextgen_welcome_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/nextgen_welcome_back"
        android:textColor="@color/nextgen_dialog_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="28dp"
        android:indeterminate="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.6"
        android:text="@string/nextgen_ad_loading"
        android:textColor="@color/nextgen_dialog_text"
        android:textSize="14sp" />
</LinearLayout>
