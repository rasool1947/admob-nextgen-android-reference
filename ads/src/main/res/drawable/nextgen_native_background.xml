<?xml version="1.0" encoding="utf-8"?>
<!-- Native ad container: its own tint and border so the ad never blends into the app's background (AdMob policy). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nextgen_native_background" />
    <stroke android:width="1dp" android:color="@color/nextgen_native_border" />
    <corners android:radius="8dp" />
</shape>
