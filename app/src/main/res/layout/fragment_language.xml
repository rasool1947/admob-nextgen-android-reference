<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".app.language.FragmentLanguage">

    <!-- Top bar -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvTitleLanguage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:text="🌐  Choose Language"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.85" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Select your preferred language to continue"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtvTitleLanguage"
        app:layout_constraintWidth_percent="0.75" />

    <!-- Continue button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbContinueLanguage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:paddingVertical="14dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/nativeAdLanguage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.7" />

    <!-- Native Ad -->
    <com.nextgen.ads.nativead.NativeAdTemplateView
        android:id="@+id/nativeAdLanguage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:nativeTemplate="medium" />

</androidx.constraintlayout.widget.ConstraintLayout>
