<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".app.main.settings.FragmentSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="20dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/tab_settings"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <include
                    android:id="@+id/rowLanguage"
                    layout="@layout/view_settings_row" />

                <include
                    android:id="@+id/rowPrivacy"
                    layout="@layout/view_settings_row" />

                <include
                    android:id="@+id/rowShare"
                    layout="@layout/view_settings_row" />

                <include
                    android:id="@+id/rowRate"
                    layout="@layout/view_settings_row" />

                <include
                    android:id="@+id/rowAdInspector"
                    layout="@layout/view_settings_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvVersionSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.5"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            tools:text="Version 0.0.1" />

        <!-- In-content ad slot of this tab (ads control main.tabs.settings) -->
        <com.nextgen.ads.nativead.NativeAdTemplateView
            android:id="@+id/adSlotSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:nativeTemplate="medium" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
