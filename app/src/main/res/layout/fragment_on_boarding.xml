<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".app.onBoarding.FragmentOnBoarding">

    <!-- Step indicator -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvStepOnBoarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_ads"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="STEP 1 OF 3"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvTitleOnBoarding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Welcome to\nAdMob Next Gen"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtvStepOnBoarding"
        app:layout_constraintWidth_percent="0.85" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Experience the next generation of Google Mobile Ads SDK with improved performance, new ad formats, and better monetization."
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:alpha="0.65"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtvTitleOnBoarding"
        app:layout_constraintWidth_percent="0.8" />

    <!-- Continue button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbContinueOnBoarding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Next →"
        android:textAllCaps="false"
        android:paddingVertical="14dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/nativeAdOnBoarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.7" />

    <!-- Native Ad -->
    <com.example.admob_next_gen.ads.natives.presentation.ui.AdNativeLargeView
        android:id="@+id/nativeAdOnBoarding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/_100sdp"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
